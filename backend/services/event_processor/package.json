{
  "name": "event-processor",
  "version": "1.0.0",
  "description": "IoT Hub event processor for robot fleet telemetry and command routing",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "lint": "eslint src/",
    "docker:build": "docker build -t event-processor .",
    "docker:run": "docker run -p 3001:3001 event-processor",
    "setup": "node src/setup.js",
    "test-auth": "./test_auth_api.sh"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.0",
    "@azure/digital-twins-core": "^1.1.0",
    "@azure/event-hubs": "^5.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/service-bus": "^7.0.0",
    "azure-iothub": "^1.5.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "event-processor",
