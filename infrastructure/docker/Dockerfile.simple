FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install express cors helmet jsonwebtoken bcryptjs

# Copy our simple server
COPY simple-auth-server.js .

# Expose port
EXPOSE 3001

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3001

# Run the application
CMD ["node", "simple-auth-server.js"]
