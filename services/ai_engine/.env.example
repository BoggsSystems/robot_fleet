# AI Engine Configuration

# OpenAI API (for advanced intent parsing)
OPENAI_API_KEY=your-openai-api-key-here

# Azure Services
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_SERVICE_BUS_CONNECTION=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key

# Application Settings
LOG_LEVEL=INFO
MAX_WORKERS=4
MODEL_CACHE_DIR=./models
VECTOR_DB_PATH=./data/vectors

# AI Model Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
INTENT_MODEL=microsoft/DialoGPT-medium
ANOMALY_CONTAMINATION=0.1

# Performance Settings
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
CACHE_TTL=3600

# C# Service Integration
C#_SERVICE_URL=http://localhost:7000
C#_SERVICE_TIMEOUT=10
