<mujoco model="box_training">
  <include file="g1_23dof.xml"/>

  <statistic center="0 0 0.5" extent="5.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="shelf_mat" rgba="0.6 0.6 0.6 1"/>
    <material name="box_mat" rgba="0.8 0.4 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Target Shelf -->
    <geom name="target_shelf" type="box" size="0.3 0.5 0.6" pos="1.2 0.0 0.6" material="shelf_mat"/>
    
    <!-- THE BOX -->
    <body name="training_box" pos="1.2 0.0 1.3">
        <freejoint/>
        <geom name="box_geom" type="box" size="0.15 0.15 0.15" material="box_mat" condim="3" friction="0.5 0.005 0.0001"/>
        <inertial pos="0 0 0" mass="1.0" diaginertia="0.01 0.01 0.01"/>
    </body>

    <!-- Initial Position for Robot (facing the box) -->
    <!-- Robot 100 will walk toward this -->
  </worldbody>
</mujoco>
